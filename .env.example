# Copy to .env and fill in.

# Path to the OAuth client secrets file you download from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_PATH=client_secret.json
GOOGLE_TOKEN_PATH=token.json

# Comma-separated Classroom course IDs to watch (find via classroom.google.com URL,
# or list them with the helper script described in the README).
COURSE_IDS=123456789012,987654321098

# Local model server
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen3:8b
MODEL_THINKING=true

# Pipeline behavior
POLL_INTERVAL_SECONDS=300
# AUTO_RETURN=false means: post draftGrade + feedback comment, and you click
# "Return" yourself in Classroom once you've skimmed it.
# AUTO_RETURN=true means: grade AND return automatically, no review step.
AUTO_RETURN=false

DB_PATH=grading_state.sqlite3

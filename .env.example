# Copy to .env and fill in.

# Path to the OAuth client secrets file you download from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_PATH=client_secret.json
GOOGLE_TOKEN_PATH=token.json

# Comma-separated Classroom course IDs to watch (find via classroom.google.com URL,
# or list them with the helper script described in the README).
COURSE_IDS=123456789012,987654321098

# Local model server
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen3:8b
MODEL_THINKING=false
MODEL_TIMEOUT_SECONDS=1800
MODEL_CTX_SIZE=16384

# Prompt budgeting
MAX_ESSAY_CHARS=12000
MAX_CALIBRATION_CHARS=2500
MAX_CALIBRATION_EXAMPLES=3

# Pipeline behavior
OUTPUT_PATH=grading_recommendations.csv
CALIBRATION_DIR=calibration
DB_PATH=grading_state.sqlite3
